# ==============================================================================
# Séance Studio — Environment Configuration Template
# ==============================================================================
# IMPORTANT: This application is strictly OFFLINE-FIRST.
# Do NOT enter cloud API keys, external endpoints, or telemetry URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Allowed Origins (Comma-separated local loopback URLs)
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"

# ------------------------------------------------------------------------------
# Database Persistence (SQLite)
# ------------------------------------------------------------------------------
# Local SQLite database file path. Default resides in backend/data/ directory.
DATABASE_URL="sqlite:///./data/seance_studio.db"

# ------------------------------------------------------------------------------
# Local AI Provider Configuration (Ollama)
# ------------------------------------------------------------------------------
# Base URL for the local Ollama daemon (must be running on loopback)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Local models installed on this workstation:
#   - qwen3:4b        (Primary text-generation model for character dialogue)
#   - qwen3-vl:8b     (Optional vision-language model for evidence analysis)
OLLAMA_MODEL="qwen3:4b"
OLLAMA_VISION_MODEL="qwen3-vl:8b"

# Inference parameters & connection timeouts
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE="5m"
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=300

# Safety Guardrail: Never automatically download or swap models
ALLOW_MODEL_AUTO_DOWNLOAD=false

# ------------------------------------------------------------------------------
# Offline & Privacy Guarantees
# ------------------------------------------------------------------------------
OFFLINE_STRICT_MODE=true
ENABLE_TELEMETRY=false
ENABLE_ANALYTICS=false

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
NEXT_PUBLIC_APP_NAME="Séance Studio"
NEXT_PUBLIC_APP_VERSION="1.0.0"
